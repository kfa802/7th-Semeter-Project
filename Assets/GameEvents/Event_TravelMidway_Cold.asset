  subtitles:
  - startTime: 0
    endTime: 2
    text: 'Bamboo needs water to grow, '
  - startTime: 2
    endTime: 4
    text: "and it can\u2019t use frozen water. "
  - startTime: 4
    endTime: 7
    text: 'The valley is warmer, so there is more bamboo.  '
  - startTime: 7
    endTime: 9.8
    text: 'Pandas follow the bamboo and travel up  '
  - startTime: 9.8
    endTime: 12
    text: 'and down the mountains throughout the year. '
