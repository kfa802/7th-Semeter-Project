  m_Name: Q6
  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestion
  id: Q5
  textDA: "Hvordan kan DU hj\xE6lpe med at beskytte pandaerne og deres hjem?"
  textEN: How can YOU help protect pandas and their homes?
  multiSelect: 1
  showLetters: 1
  horizontalLayout: 0
  logAsNumber: 0
  options:
  - textDA: "Give pandaer mad, hvis jeg m\xF8der dem i naturen."
    textEN: 'Feed pandas if you see them in the wild. '
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
  - textDA: "Bes\xF8ge zoologiske haver, der hj\xE6lper med at avle pandaer for at
      beskytte dem."
    textEN: 'Visit zoos that help breed pandas to protect them. '
    correct: 1
    exclusive: 0
    icon: {fileID: 0}
  - textDA: "K\xF8be alle de bambusprodukter, du kan finde."
    textEN: Buy any bamboo products you can find.
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
  - textDA: "Kigge efter FSC-m\xE6rket, n\xE5r du k\xF8ber bambusprodukter."
    textEN: 'Look for the FSC label when buying bamboo products. '
    correct: 1
    exclusive: 0
    icon: {fileID: 0}
  - textDA: "Der er ikke noget, jeg kan g\xF8re for at hj\xE6lpe pandaer."
    textEN: There is nothing I can do to help pandas.
    correct: 0
    exclusive: 1
    icon: {fileID: 0}
  - textDA: Det ved jeg ikke.
    textEN: 'I don''t know. '
    correct: 0
    exclusive: 1
    icon: {fileID: 0}
