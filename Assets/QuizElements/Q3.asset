  m_Script: {fileID: 11500000, guid: 4009c2ac4ce9d4a538b75ec927c050c7, type: 3}
  m_Name: Q3
  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestion
  id: Q3
  textDA: "Hvorfor kan det v\xE6re sv\xE6rt for to pandaer at leve i det samme omr\xE5de? "
  textEN: Why can it be difficult for two pandas to live in the same area?
  multiSelect: 0
  showLetters: 1
  horizontalLayout: 0
  logAsNumber: 0
  options:
  - textDA: "De har brug for meget bambus og plads, s\xE5 der m\xE5ske ikke er nok
      til dem begge. "
    textEN: They need lots of bamboo and space, so there might not be enough for
      both.
    correct: 1
    exclusive: 0
    icon: {fileID: 0}
  - textDA: "De sl\xE5s altid, n\xE5r de m\xF8der en anden panda. "
    textEN: 'They always fight when they see another panda. '
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
  - textDA: "De er n\xF8dt til at leve i grupper for at finde nok mad."
    textEN: They need to live in groups to find enough food.
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
  - textDA: De kan ikke genkende andre pandaer i skoven.
    textEN: They cannot recognise other pandas in the forest.
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
