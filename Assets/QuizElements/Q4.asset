  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestion
  id: Q1
  textDA: Hvad kan der ske med pandaer, hvis man bygger en vej gennem en skov?
  textEN: What can happen to pandas when a road is built through a forest?
  multiSelect: 0
  showLetters: 1
  horizontalLayout: 0
  logAsNumber: 0
  options:
  - textDA: "Det g\xF8r det lettere for pandaer at finde andre pandaer."
    textEN: It makes it easier for pandas to find other pandas.
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
  - textDA: Det giver pandaerne flere steder at finde bambus.
    textEN: It gives pandas more places to find bamboo.
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
  - textDA: "Det deler skoven i to og skaber mere st\xF8j og forurening."
    textEN: 'It splits the forest and brings more noise and pollution. '
    correct: 1
    exclusive: 0
    icon: {fileID: 0}
  - textDA: "Det g\xF8r skoven varmere."
    textEN: It makes the forest warmer.
    correct: 0
    exclusive: 0
