  m_EditorClassIdentifier: Assembly-CSharp::QuizQuestion
  id: Q4c
  textDA: "Hvordan kan vi hj\xE6lpe pandaer og mennesker med at leve trygt t\xE6t
    p\xE5 hinanden?"
  textEN: What is needed for humans and pandas to share the space in the valleys?
  multiSelect: 0
  showLetters: 1
  horizontalLayout: 0
  logAsNumber: 0
  options:
  - textDA: "Ved at beskytte skovene og s\xF8rge for, at de h\xE6nger sammen. "
    textEN: By protecting forests and keeping them connected.
    correct: 1
    exclusive: 0
    icon: {fileID: 0}
  - textDA: "Ved at l\xE6re pandaer at ignorere h\xF8je lyde. "
    textEN: 'By teaching pandas to ignore loud noises. '
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
  - textDA: Ved at bygge flere veje gennem skovene.
    textEN: 'By building more roads through forests. '
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
  - textDA: Ved at flytte alle pandaer op i bjergene.
    textEN: By moving all pandas to the mountains.
    correct: 0
    exclusive: 0
    icon: {fileID: 0}
